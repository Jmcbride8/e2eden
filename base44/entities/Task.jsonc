{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "description": {
      "type": "string",
      "description": "Task description"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of assigned user"
    },
    "assigned_company": {
      "type": "string",
      "enum": [
        "E2Eden",
        "Seawater Greenhouse",
        "Partner",
        "Other"
      ],
      "description": "Company this task is assigned to"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "completed"
      ],
      "default": "todo",
      "description": "Task status"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Due date"
    }
  },
  "required": [
    "title",
    "assigned_company"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "$or": [
                {
                  "created_by_id": "{{user.id}}"
                },
                {
                  "$and": [
                    {
                      "data.assigned_to": "{{user.email}}"
                    },
                    {
                      "data.assigned_to": {
                        "$nin": [
                          null,
                          ""
                        ]
                      }
                    }
                  ]
                },
                {
                  "$and": [
                    {
                      "data.assigned_company": "{{user.data.company}}"
                    },
                    {
                      "data.assigned_company": {
                        "$in": [
                          "E2Eden",
                          "Seawater Greenhouse",
                          "Partner",
                          "Other"
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.company": "E2Eden"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.company": "Seawater Greenhouse"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.company": "Partner"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.company": "Other"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "$or": [
                {
                  "created_by_id": "{{user.id}}"
                },
                {
                  "data.assigned_to": "{{user.email}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}