{
  "name": "PartnershipCategory",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Category title"
    },
    "description": {
      "type": "string",
      "description": "Category description"
    },
    "icon": {
      "type": "string",
      "description": "Icon name (e.g., Globe, Lightbulb)"
    },
    "color": {
      "type": "string",
      "description": "Text color class"
    },
    "bg": {
      "type": "string",
      "description": "Background color class"
    },
    "border": {
      "type": "string",
      "description": "Border color class"
    },
    "partners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        }
      },
      "description": "List of partners"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of benefits"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order"
    }
  },
  "required": [
    "title",
    "description"
  ]
}