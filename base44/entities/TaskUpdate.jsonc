{
  "name": "TaskUpdate",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "ID of the task this update belongs to",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "comment": {
      "type": "string",
      "description": "Update comment or description"
    },
    "update_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the update"
    }
  },
  "required": [
    "task_id",
    "comment",
    "update_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.company": "E2Eden"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.company": "Seawater Greenhouse"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.company": "Partner"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.company": "Other"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}