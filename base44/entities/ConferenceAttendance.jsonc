{
  "name": "ConferenceAttendance",
  "type": "object",
  "properties": {
    "conference_id": {
      "type": "string",
      "description": "ID of the conference",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "attending",
        "maybe",
        "not_attending"
      ],
      "description": "Attendance status"
    }
  },
  "required": [
    "conference_id",
    "user_email",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.user_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.user_email": "{{user.email}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "user",
                    "data.company": "E2Eden"
                  }
                },
                {
                  "user_condition": {
                    "role": "user",
                    "data.company": "Seawater Greenhouse"
                  }
                },
                {
                  "user_condition": {
                    "role": "user",
                    "data.company": "Partner"
                  }
                },
                {
                  "user_condition": {
                    "role": "user",
                    "data.company": "Other"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.user_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.user_email": "{{user.email}}"
            }
          ]
        }
      ]
    }
  }
}