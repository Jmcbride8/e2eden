{
  "name": "ConferenceAttendance",
  "type": "object",
  "properties": {
    "conference_id": {
      "type": "string",
      "description": "ID of the conference"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "status": {
      "type": "string",
      "enum": [
        "attending",
        "maybe",
        "not_attending"
      ],
      "description": "Attendance status"
    }
  },
  "required": [
    "conference_id",
    "user_email",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    }
  }
}