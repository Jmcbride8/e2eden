{
  "name": "Conference",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Conference or meeting name"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Conference start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Conference end date"
    },
    "location": {
      "type": "string",
      "description": "Conference website or registration link"
    },
    "link": {
      "type": "string",
      "description": "Conference website or registration link"
    },
    "cost": {
      "type": "number",
      "description": "Cost to attend (0 if free)"
    },
    "owner": {
      "type": "string",
      "description": "Person who added this opportunity"
    },
    "description": {
      "type": "string",
      "description": "Additional details about the conference"
    }
  },
  "required": [
    "name",
    "start_date",
    "location"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.company": "E2Eden"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.company": "Seawater Greenhouse"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.company": "Partner"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.company": "Other"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}